
attribute @s minecraft:waypoint_transmit_range modifier remove lbo:customize
attribute @s minecraft:waypoint_transmit_range modifier add lbo:customize 10000 add_value
#trim receive to match transmit
execute store result score $transmit_range lbo.menu run attribute @s minecraft:waypoint_transmit_range get
execute store result score $receive_range lbo.menu run attribute @s minecraft:waypoint_receive_range get
execute if score $receive_range lbo.menu > $transmit_range lbo.menu run attribute @s minecraft:waypoint_receive_range modifier remove lbo:customize
execute if score $receive_range lbo.menu > $transmit_range lbo.menu run attribute @s minecraft:waypoint_receive_range modifier add lbo:customize 10000 add_value

